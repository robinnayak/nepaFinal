{
    "version": 2,
    "builds": [
      {
        "src": "nepaFinal/wsgi.py",
        "use": "@vercel/python",
        "config": { "maxLambdaSize": "15mb", "runtime": "python3.9" }
      },
        {
            "src": "build.sh",
            "use": "@vercel/static-build",
            "config":{
                "distDir": "staticfiles_builds"
            }
        }
    ],
    "routes": [
      {
        "src": "/static/(.*)",
        "dest": "/static/$1"
      },
      {
        "src": "/(.*)",
        "dest": "nepaFinal/wsgi.py"
      }
    ]
  }


